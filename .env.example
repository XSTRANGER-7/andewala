# ---------------------------------------------------------------------------
# AndeWala configuration. Never commit this file.
# ---------------------------------------------------------------------------

# ---- Database: Supabase Postgres ------------------------------------------
# Supabase dashboard > your project > Connect (top bar) > "ORMs" tab > Prisma.
# Copy the two strings it shows and replace [YOUR-PASSWORD] with your database
# password (Project Settings > Database > Reset database password if you lost it).
# The host (aws-0-... or aws-1-..., with your region) must match what Connect shows.

# Pooled connection, used by the app (port 6543, transaction pooler).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session/direct connection, used only to create and change tables (port 5432).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---- Supabase project -------------------------------------------------------
# Project Settings > API Keys. Use the publishable key (sb_publishable_...).
# Never put the secret / service_role key here.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

# Let Supabase Auth send and check login codes for these channels: "phone", "email" or "phone,email".
# Leave empty to have the app send codes itself (Resend / MSG91 / Twilio below; in development
# the code is shown on screen). For "phone", set up an SMS provider in Supabase first:
# Authentication > Providers > Phone (Twilio, MessageBird, Vonage or Textlocal).
SUPABASE_AUTH_OTP=""

# ---- App ----------------------------------------------------------------------
ADMIN_PASSWORD="change-me-to-something-long"
# Signs login and admin cookies. Changing it signs everyone out.
AUTH_SECRET="replace-with-48-random-characters"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Login codes sent by the app itself (when SUPABASE_AUTH_OTP doesn't cover a channel)
# Verification codes by email. Your own mailbox over SMTP (Hostinger shown), or Resend.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="contact@andewala.store"
SMTP_PASS=""
EMAIL_FROM="AndeWala <contact@andewala.store>"
# Site-wide email budget (per hour / per day), on top of the per-address limits.
EMAIL_CODES_PER_HOUR="100"
EMAIL_CODES_PER_DAY="500"
RESEND_API_KEY=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Mobile codes via Twilio Verify, sent by the app directly (used when SUPABASE_AUTH_OTP doesn't include "phone").
# Needs TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN above, plus the Verify Service SID (starts with VA).
TWILIO_VERIFY_SERVICE_SID=""

# --- Online payment (Razorpay: UPI, cards, netbanking) ---
# Dashboard > Account & Settings > API keys. Use rzp_test_ keys to try it, rzp_live_ keys for real money.
# "Pay online" appears at checkout only when both are set.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard > Webhooks > Add: URL https://YOUR-SITE/api/razorpay/webhook,
# events payment.authorized + payment.captured, and this secret.
RAZORPAY_WEBHOOK_SECRET=""

# --- Sign in with Google (optional) ---
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (Web application).
# Authorised redirect URIs: https://YOUR-SITE/api/auth/google/callback and http://localhost:3000/api/auth/google/callback
# The "Continue with Google" button shows only when both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
